# Copy this file to ".env" (same folder) and fill it in. Never share .env or paste the key into chat.

# manual = free (copy the AI instruction into the Gemini app yourself)
# gemini = automatic renders with your Google API key (Google charges per image).
#          EXPERIMENTAL until one real render has worked. Check your key for free first:
#          py server\app.py --check
# mock   = testing only, no AI
RENDER_MODE=manual

# Only needed for RENDER_MODE=gemini. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google's image model. Check https://ai.google.dev/gemini-api/docs/pricing for current names and prices.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# The real safety cap: most automatic renders per day (failed attempts don't count).
# Also add a budget alert in Google Cloud billing. Note: Google budgets only send alerts; they don't stop spending.
DAILY_RENDER_LIMIT=20

PORT=8000
